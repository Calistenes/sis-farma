NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (Project Settings -> API -> service_role secret).
# NUNCA exponha com o prefixo NEXT_PUBLIC_. Usado só no webhook do Mercado
# Pago, roda em servidor, ignora RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mercado Pago (Assinaturas / Preapproval)
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADOPAGO_WEBHOOK_SECRET=your-mercadopago-webhook-secret
