# Copie para .env e preencha. NUNCA commite o .env real (já está no .gitignore).

# URL de login do portal "Meu RH" (TOTVS) da sua empresa.
# Ex: https://suaempresa.rh.totvs.com.br/ ou o endereço que você usa no navegador.
MEURH_URL=

# Credenciais do seu usuário (gestor) no Meu RH.
# Deixe em branco e use `npm run login:setup` se preferir logar manualmente
# (recomendado quando há CAPTCHA, 2FA ou login via SSO/Microsoft/Google).
MEURH_USERNAME=
MEURH_PASSWORD=

# Caminho (path ou URL completa) da página com o espelho de ponto da equipe,
# depois de logado. Ex: /gestor/ponto/equipe — ajuste depois de navegar
# manualmente e conferir a URL real.
MEURH_TEAM_TIMESHEET_PATH=

# Rodar o navegador visível (true) para depurar seletores, ou headless (false).
HEADLESS=true

# Regras de conferência (ajuste ao combinado com a empresa).
EXPECTED_DAILY_HOURS=8
MIN_PUNCHES_PER_DAY=4
